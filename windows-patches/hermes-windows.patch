+            return client.snapshot()
+        elif command == "click":
+            ref = args[0] if args else ""
+            return client.click(ref)
+        elif command == "type":
+            ref = args[0] if args else ""
+            text = args[1] if len(args) > 1 else ""
+            return client.type_text(ref, text)
+        elif command == "fill":
+            ref = args[0] if args else ""
